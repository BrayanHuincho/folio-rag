# Cópialo a .env. Solo hace falta la key del proveedor que uses.

FOLIO_DATA_DIR=./data
FOLIO_HOST=127.0.0.1
FOLIO_PORT=8765

# Cualquier proveedor:modelo, por ejemplo:
#   openrouter:anthropic/claude-sonnet-4.5
#   openai:gpt-4.1-mini
#   anthropic:claude-sonnet-4-5
#   gemini:gemini-2.5-flash
#   ollama:llama3.1
FOLIO_LLM=openrouter:anthropic/claude-sonnet-4.5
FOLIO_FAST_LLM=
# opcional: solo estos aparecen en el selector, separados por comas
FOLIO_MODELS=

# local: corre en tu CPU, nada sale de tu máquina.
FOLIO_EMBEDDINGS=local:sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

FOLIO_CHUNK_SIZE=900
FOLIO_CHUNK_OVERLAP=120
FOLIO_TOP_K=8
# tope de la respuesta; sin esto OpenRouter reserva el máximo del modelo y pide más saldo
FOLIO_MAX_TOKENS=2048
FOLIO_MAX_FILE_MB=50
FOLIO_OCR=false

OPENROUTER_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
MISTRAL_API_KEY=
DEEPSEEK_API_KEY=

OLLAMA_BASE_URL=http://localhost:11434
LMSTUDIO_BASE_URL=http://localhost:1234
